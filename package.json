{
  "name": "select-translate",
  "version": "1.6.6",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Chrome extension that translates selected text in a Google Translate-style popup.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs bundle",
    "pack": "node scripts/build.mjs pack",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/render-icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.2"
  }
}
